# =================================================================
# AI-Driven Smart Service Marketplace - Environment Configuration
# =================================================================

# Application Settings
PROJECT_NAME="AI-Driven Smart Service Marketplace"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Authentication
# Leave blank for a fresh development-only secret, or set a unique random value.
# Production requires a secret of at least 32 characters.
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Standard format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_service_marketplace"


# CORS Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173", "https://smart-service-eta.vercel.app"]

# Initial administrator. Set unique credentials before starting the backend.
FIRST_SUPERUSER_EMAIL=""
FIRST_SUPERUSER_PASSWORD=""
FIRST_SUPERUSER_NAME="System Administrator"
SEED_DEMO_DATA=False

# Private provider documents must live outside frontend/public and static paths.
# Use persistent private storage on the production backend host.
PRIVATE_UPLOAD_DIR="private_uploads"

# Booking and provider-verification email (leave unset to simulate booking email
# delivery only in development; provider email verification requires SMTP).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@example.com"
SMTP_USE_TLS=True
EMAIL_OUTBOX_POLL_SECONDS=30

# Optional SMS delivery through Twilio. Without credentials, SMS notifications
# remain queued and in-app notifications continue to work.
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SMS_OUTBOX_POLL_SECONDS=15
PROBLEM_IMAGE_MAX_BYTES=5242880

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# LLM & AI Assistant Configuration (Optional external LLM)
# If left blank, the intelligent local contextual RAG engine operates automatically
LLM_PROVIDER="openai" # "openai", "gemini", "ollama", "local"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""
