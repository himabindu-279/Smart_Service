# =================================================================
# AI-Driven Smart Service Marketplace - Environment Configuration
# =================================================================

# Application Settings
PROJECT_NAME="AI-Driven Smart Service Marketplace"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Authentication
# Generated random secret key for HMAC-SHA256 tokens
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Standard format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_marketplace"

# CORS Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Initial Super Admin (Seeded on first startup)
FIRST_SUPERUSER_EMAIL="admin@marketplace.com"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"
FIRST_SUPERUSER_NAME="System Administrator"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# LLM & AI Assistant Configuration (Optional external LLM)
# If left blank, the intelligent local contextual RAG engine operates automatically
LLM_PROVIDER="openai" # "openai", "gemini", "ollama", "local"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""
